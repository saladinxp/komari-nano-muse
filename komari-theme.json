                "help": "面板版本号 — 显示于导航栏、页脚及HUD面板"
            },
            {
                "key": "footer_text",
                "name": "[ FOOTER ] 状态栏文字",
                "type": "string",
                "default": "SYSTEM MONITORING ACTIVE",
                "help": "底部状态栏文字"
            },
            {
                "name": "◇ CHARACTER // 角色系统",
                "type": "title"
            },
            {
                "key": "char_url",
                "name": "[ CHAR ] 角色图片链接",
                "type": "string",
                "default": "",
                "help": "Hero区域角色图 — 留空使用默认 char.png"
            },
            {
                "name": "◇ ANNOUNCE // 公告系统",
                "type": "title"
            },
            {
                "key": "announce_text",
                "name": "[ NOTICE ] 公告内容",
                "type": "string",
                "default": "",
                "help": "首页公告 — 留空隐藏公告栏"
            }
        ]
    }
